<file path="internal/adapters/outbound/redis_lock_adapter.go">
package outbound

import (
	"context"
	"time"

	"github.com/redis/go-redis/v9"
)

type RedisLockAdapter struct {
	client *redis.Client
}

func NewRedisLockAdapter(redisAddr string) *RedisLockAdapter {
	client := redis.NewClient(&redis.Options{
		Addr: redisAddr,
	})

	return &RedisLockAdapter{
		client: client,
	}
}

func (r *RedisLockAdapter) Acquire(ctx context.Context, key string, ttl time.Duration) (bool, error) {
	success, err := r.client.SetNX(ctx, key, "locked", ttl).Result()
	if err != nil {
		return false, err
	}
	return success, nil
}

func (r *RedisLockAdapter) Release(ctx context.Context, key string) error {
	return r.client.Del(ctx, key).Err()
}
</file>

<file path="internal/app/app.go">
package app

import (
	"context"
	"log"
	"net/http"
	"os"
	"os/signal"
	"sync"
	"syscall"
	"time"

	"github.com/MahdiRohani/request-meter/internal/adapters/inbound"
	"github.com/MahdiRohani/request-meter/internal/adapters/outbound"
	"github.com/MahdiRohani/request-meter/internal/core/services"
	"github.com/gin-gonic/gin"
	"github.com/joho/godotenv"
)

func Run() {
	if err := godotenv.Load(); err != nil {
		log.Println("Warning: No .env file found. Using system environment variables.")
	}

	dbURL := os.Getenv("DATABASE_URL")
	if dbURL == "" {
		log.Fatal("DATABASE_URL is required in .env")
	}

	redisAddr := os.Getenv("REDIS_ADDR")
	if redisAddr == "" {
		log.Fatal("REDIS_ADDR is required in .env")
	}

	serverPort := os.Getenv("SERVER_PORT")
	if serverPort == "" {
		serverPort = "8080"
	}

	syncIntervalStr := os.Getenv("SYNC_INTERVAL")
	syncInterval, err := time.ParseDuration(syncIntervalStr)
	if err != nil || syncInterval <= 0 {
		syncInterval = 500 * time.Millisecond
	}

	postgres := outbound.NewPostgresRepository(dbURL)

	redisLock := outbound.NewRedisLockAdapter(redisAddr)

	memoryRepo := outbound.NewInMemoryRepository()

	counterService := services.NewCounterService(memoryRepo, postgres, redisLock)

	ctx, cancelWorker := context.WithCancel(context.Background())
	var wg sync.WaitGroup

	counterService.StartSync(ctx, &wg, syncInterval)

	counterHandler := inbound.NewCounterHandler(counterService)

	log.SetFlags(log.LstdFlags | log.Lmicroseconds)
	gin.SetMode(gin.ReleaseMode)

	router := gin.Default()
	router.POST("/counter/:name", counterHandler.IncrementEndpoint)
	router.GET("/stats/:name", counterHandler.GetStateEndpoint)

	srv := &http.Server{
		Addr:    ":" + serverPort,
		Handler: router,
	}

	go func() {
		log.Printf("Server is running on port %s...", serverPort)
		if err := srv.ListenAndServe(); err != nil && err != http.ErrServerClosed {
			log.Fatalf("listen: %s\n", err)
		}
	}()

	quit := make(chan os.Signal, 1)
	signal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)
	<-quit

	log.Println("Shutting down server gracefully...")

	cancelWorker()

	wg.Wait()
	ctxShutdown, cancelShutdown := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancelShutdown()

	if err := srv.Shutdown(ctxShutdown); err != nil {
		log.Fatal("Server forced to shutdown:", err)
	}

	log.Println("Server exiting successfully. Data saved.")
}
